# 1. Copy this file and name the copy exactly:  .env
# 2. Paste your key from https://aistudio.google.com/apikey after the = sign
# 3. Save. Never share or commit the .env file (.gitignore already blocks it).

GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Optional: which Gemma 4 model to use.
#   gemma-4-26b-a4b-it  (default, faster)
#   gemma-4-31b-it      (stronger reasoning, slower)
# GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: a free GitHub token raises GitHub's rate limit (60 -> 5000 requests/hour).
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
# GITHUB_TOKEN=
